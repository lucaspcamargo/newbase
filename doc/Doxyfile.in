PROJECT_NAME           = "newbase Engine"
PROJECT_NUMBER         = "@NEWBASE_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/doc/Doxygen Index.md"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/doc/Doxygen Index.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src"
RECURSIVE              = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
