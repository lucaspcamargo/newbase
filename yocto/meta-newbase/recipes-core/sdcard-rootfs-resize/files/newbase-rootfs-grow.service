[Unit]
Description=Grow root partition and filesystem to fill SD card/eMMC
# Mirrors systemd's own systemd-growfs-root.service ordering, since this
# does the equivalent job for an MBR-partitioned image (see
# newbase-rootfs-grow.sh for why systemd-repart/systemd-growfs aren't used
# directly).
DefaultDependencies=no
After=systemd-remount-fs.service
Before=basic.target sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/newbase-rootfs-grow.sh
TimeoutSec=infinity

[Install]
WantedBy=sysinit.target
