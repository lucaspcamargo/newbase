+++ b/vendored/SDL/src/video/SDL_video.c
@@ -668,10 +668,13 @@ bool SDL_VideoInit(const char *driver_name)
                 if (!bootstrap[i]->is_preferred &&
                     (driver_attempt_len == SDL_strlen(bootstrap[i]->name)) &&
                     (SDL_strncasecmp(bootstrap[i]->name, driver_attempt, driver_attempt_len) == 0)) {
+                    SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Trying video driver '%s'...", bootstrap[i]->name);
                     video = bootstrap[i]->create();
                     if (video) {
+                        SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Video driver '%s' initialized successfully", bootstrap[i]->name);
                         break;
                     }
+                    SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Video driver '%s' failed: %s", bootstrap[i]->name, SDL_GetError());
                 }
             }
 
@@ -679,10 +682,13 @@ bool SDL_VideoInit(const char *driver_name)
         }
     } else {
         for (i = 0; bootstrap[i]; ++i) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Trying video driver '%s'...", bootstrap[i]->name);
             video = bootstrap[i]->create();
             if (video) {
+                SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Video driver '%s' initialized successfully", bootstrap[i]->name);
                 break;
             }
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "Video driver '%s' failed: %s", bootstrap[i]->name, SDL_GetError());
         }
     }
     if (video) {
