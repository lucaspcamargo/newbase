#pragma once

#include "./constants.slangh"

// Light data and helper functions

struct LightEntry
{
    // xyz = World Position (Point/Spot) or Direction (Directional)
    // w   = Light Type (0 = Directional, 1 = Point, 2 = Spot)
    float4 pos_dir;

    // direction in case of spot lights
    // w is padding but could be used for something else later
    float4 spot_dir;

    // rgb = Color * Intensity
    // w   = Range (Point/Spot)
    float4 color;

    // x = Linear attenuation
    // y = Quadratic attenuation
    // z = Inner cone angle cosine (Spot)
    // w = Outer cone angle cosine (Spot)
    float4 params;

    // shadow mapping shit
    column_major float4x4 light_view_proj;
    uint4 map_layer_idx;
};


struct LightsBlock
{
    float3 ambient;
    float _pad0;
    LightEntry lights[SCENE_LIGHTS_MAX];
};

float calculateSpotLightShadow(LightEntry light, Sampler2DArray shadowTex, float3 worldPosition)
{
    if (light.map_layer_idx.x == 0xffffffff)
    {
        return 1.0; // no shadow map :)
    }

    float4 lightSpacePos = mul(light.light_view_proj, float4(worldPosition, 1.0));

    if (lightSpacePos.w <= 0.0)
    {
        return 0.5;
    }

    lightSpacePos.xyz /= lightSpacePos.w;

    // NDC to UV space
    float2 shadowUV = lightSpacePos.xy * float2(0.5, -0.5) + float2(0.5, 0.5);

    // check frustum
    if (shadowUV.x < 0.0 || shadowUV.x > 1.0 ||
        shadowUV.y < 0.0 || shadowUV.y > 1.0 ||
        lightSpacePos.z < 0.0 || lightSpacePos.z > 1.0)
    {
        return 0.25;
    }

    float currentDepth = lightSpacePos.z;

    // sample depth
    float sampledDepth = shadowTex.Sample(
        float3(shadowUV, float(light.map_layer_idx.x))
    ).r;

    // we use front-face culling, there is no bias
    // this might need to change for billboards, vegetation, etc
    return (currentDepth <= sampledDepth) ? 1.0 : 0.0;
}
